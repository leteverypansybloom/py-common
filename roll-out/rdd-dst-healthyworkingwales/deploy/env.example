# Example environment variables for production deployment
# Copy to .env or export in Cloud Run Job configuration
# Never commit actual values—only placeholder names

# SharePoint Configuration
SHAREPOINT_TENANT_ID=your-azure-tenant-id
SHAREPOINT_CLIENT_ID=your-entra-app-id
SHAREPOINT_HOSTNAME=contoso.sharepoint.com
SHAREPOINT_SITE_PATH=/sites/YourDataSite
SHAREPOINT_LIBRARY=Shared Documents
SHAREPOINT_FOLDER=Uploads

# Google Cloud Platform
GCP_PROJECT=your-gcp-project-id
GCS_BUCKET_RAW=raw-excel-files
GCS_BUCKET_PROCESSED=processed-parquet-files
BIGQUERY_DATASET=ingestion
BIGQUERY_TABLE_STAGING=events_staging
BIGQUERY_TABLE_FINAL=events
BIGQUERY_TABLE_AUDIT=audit_log

# Secret Manager
# The actual credential value is stored in Secret Manager
# Only the secret NAME is in configuration
SECRET_MANAGER_SECRET_NAME=sharepoint-credential

# Runtime
ENVIRONMENT=prod
LOG_LEVEL=INFO

# Optional: For local testing before cloud setup
# (Remove or comment out for production)
# SHAREPOINT_TEST_FOLDER=./test_files
